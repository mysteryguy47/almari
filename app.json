{
  "expo": {
    "name": "Almari",
    "slug": "almari",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "almari",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "in.blackmonkey.almari"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#34574A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "in.blackmonkey.almari",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "almari.blackmonkey.in",
              "pathPrefix": "/join/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": false,
            "default": false
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#12110E",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76,
          "dark": {
            "backgroundColor": "#12110E"
          }
        }
      ],
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Almari uses the camera to photograph your documents.",
          "photosPermission": "Almari lets you pick photos of documents you already have."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Almari uses Face ID to unlock your family vault."
        }
      ],
      "expo-font",
      "react-native-libsodium",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#34574A"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Almari uses the camera to photograph your documents.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "description": "Ghar ke saare kaagaz, ek jagah. A family vault for documents, ID numbers, passwords and bank details.",
    "backgroundColor": "#12110E",
    "extra": {
      "eas": {
        "projectId": "f2ed7011-676c-4aa2-953f-187ef29eb2d3"
      }
    },
    "owner": "ayushkhurana47s-team"
  }
}
