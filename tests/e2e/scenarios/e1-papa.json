{
  "profile": "e-papa", "fresh": true, "noWebShare": true,
  "steps": [
    ["go", "/welcome", 6000],
    ["tap", "get-started"],
    ["waitFor", "Create your account", 10000],
    ["type", "name", "Ayush Khurana"], ["type", "email", "{{papaEmail}}"], ["type", "password", "{{pass}}"],
    ["tap", "create-account"],
    ["waitFor", "Check your email", 15000],
    ["mailLink", "{{papaEmail}}"],
    ["waitFor", "About you", 30000],
    ["tap", "you-continue"],
    ["waitFor", "Name your family", 10000],
    ["tap", "create-family"],
    ["waitFor", "Who is in the family?", 20000],
    ["tap", "add-member"],
    ["waitFor", "Add a family member", 10000],
    ["type", "member-name", "Riya Khurana"], ["type", "member-relation", "Riya"], ["type", "member-email", "{{riyaEmail}}"],
    ["tap", "member-save"],
    ["waitFor", "Invite Riya", 15000],
    ["save", "riyaInvite", "document.querySelector('[data-testid=\"invite-link\"]')?.innerText"],
    ["text", "Close"], ["wait", 1500],
    ["tap", "members-continue"],
    ["waitFor", "Who sees personal papers?", 10000],
    ["tap", "privacy-continue"],
    ["waitFor", "Set your app PIN", 10000],
    ["tap", "set-pin-1"], ["tap", "set-pin-3"], ["tap", "set-pin-5"], ["tap", "set-pin-7"],
    ["waitFor", "Enter it once more", 5000],
    ["tap", "set-pin-1"], ["tap", "set-pin-3"], ["tap", "set-pin-5"], ["tap", "set-pin-7"],
    ["waitFor", "Your PIN is set.", 5000],
    ["tap", "open-family"],
    ["waitFor", "Namaste, Ayush", 10000],
    ["go", "/doc/new?template=pan", 4000],
    ["tap", "lock-pin-1"], ["tap", "lock-pin-3"], ["tap", "lock-pin-5"], ["tap", "lock-pin-7"],
    ["wait", 1500],
    ["file", "pick-photos", "testimg/photo-test.png,testimg/page-2.png"],
    ["eval", "document.body.innerText.includes('Page 2') ? 'two pages added' : 'EXPECTED two pages'"],
    ["tap", "doc-more"],
    ["type", "doc-number", "ABCPE1234F"],
    ["tap", "doc-save"],
    ["waitFor", "Safe in the almari", 15000],
    ["wait", 6000],
    ["go", "/settings", 4000],
    ["tap", "lock-pin-1"], ["tap", "lock-pin-3"], ["tap", "lock-pin-5"], ["tap", "lock-pin-7"],
    ["waitFor", "Synced", 30000],
    ["expectNot", "waiting to sync"]
  ]
}
