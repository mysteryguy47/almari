{
  "profile": "d-look",
  "steps": [
    ["go", "/task/new", 6000],
    ["waitFor", "New task", 10000],
    ["type", "task-title", "Pay the school fees"],
    ["eval", "(() => { const sw = document.querySelector('[data-testid=\"task-has-due\"] [role=\"switch\"], [data-testid=\"task-has-due\"] input, input[data-testid=\"task-has-due\"]'); if (!sw) return 'MISSING switch'; sw.click(); return 'ok'; })()"],
    ["wait", 1200],
    ["waitFor", "Due ", 5000],
    ["tap", "task-quick-week"],
    ["wait", 1200],
    ["save", "dueLine", "document.querySelector('[data-testid=\"task-has-due\"]')?.closest('[class]')?.parentElement?.innerText.split('\\n').find(l => l.startsWith('Due ')) || [...document.querySelectorAll('div')].map(d => d.innerText).find(t => /^Due \\w/.test(t))"],
    ["scroll", "task-date-day", 88],
    ["wait", 1500],
    ["save", "dueLine2", "[...document.querySelectorAll('div')].map(d => d.innerText).find(t => /^Due \\w/.test(t))"],
    ["shot", "d2-01-task-wheels", "full"],
    ["tap", "task-save"],
    ["waitFor", "Assigned to", 8000],
    ["go", "/bank/new", 5000],
    ["type", "bank-number", "12345678901"],
    ["type", "bank-ifsc", "SBIN0000691"],
    ["waitFor", "New Delhi Main Branch", 15000],
    ["tap", "bank-more"],
    ["wait", 800],
    ["eval", "document.querySelector('[data-testid=\"bank-branch\"]')?.value || (document.querySelector('[data-testid=\"bank-branch\"] input')?.value) || 'EXPECTED branch filled'"],
    ["shot", "d2-02-bank-ifsc", "full"],
    ["go", "/settings/family", 5000],
    ["waitFor", "Year on the nameplate", 8000],
    ["shot", "d2-03-family-year", "full"],
    ["dark", true],
    ["go", "/", 5000],
    ["shot", "d2-04-home-dark"]
  ]
}
