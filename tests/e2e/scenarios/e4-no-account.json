{
  "profile": "e-neha", "fresh": true, "noWebShare": true,
  "steps": [
    ["go", "/welcome", 6000],
    ["tap", "no-account"],
    ["waitFor", "About you", 10000],
    ["type", "you-name", "Neha Arora"],
    ["tap", "you-continue"],
    ["waitFor", "Name your family", 10000],
    ["expect", "never reach our server"],
    ["tap", "create-family"],
    ["waitFor", "Who is in the family?", 20000],
    ["tap", "members-continue"],
    ["waitFor", "Who sees personal papers?", 10000],
    ["tap", "privacy-continue"],
    ["waitFor", "Set your app PIN", 10000],
    ["tap", "set-pin-1"], ["tap", "set-pin-4"], ["tap", "set-pin-7"], ["tap", "set-pin-2"],
    ["waitFor", "Enter it once more", 5000],
    ["tap", "set-pin-1"], ["tap", "set-pin-4"], ["tap", "set-pin-7"], ["tap", "set-pin-2"],
    ["waitFor", "Your PIN is set.", 5000],
    ["tap", "open-family"],
    ["waitFor", "Namaste, Neha", 10000],
    ["go", "/note/new", 4000],
    ["tap", "lock-pin-1"], ["tap", "lock-pin-4"], ["tap", "lock-pin-7"], ["tap", "lock-pin-2"],
    ["wait", 1500],
    ["type", "note-title", "Phone only note"],
    ["type", "note-body", "Never leaves this phone"],
    ["tap", "note-save"],
    ["wait", 2000],
    ["go", "/settings", 4000],
    ["tap", "lock-pin-1"], ["tap", "lock-pin-4"], ["tap", "lock-pin-7"], ["tap", "lock-pin-2"],
    ["waitFor", "This phone only", 10000],
    ["expect", "Back up to the cloud"],
    ["expectNot", "Sign out"],
    ["shot", "e4-01-settings-local", "full"],
    ["reload", 5000],
    ["tap", "lock-pin-1"], ["tap", "lock-pin-4"], ["tap", "lock-pin-7"], ["tap", "lock-pin-2"],
    ["waitFor", "Namaste, Neha", 10000],
    ["go", "/auth/sign-up", 4000],
    ["type", "name", "Neha Arora"], ["type", "email", "{{nehaEmail}}"], ["type", "password", "{{pass}}"],
    ["tap", "create-account"],
    ["waitFor", "Check your email", 15000],
    ["mailLink", "{{nehaEmail}}"],
    ["waitFor", "Namaste, Neha", 30000],
    ["go", "/settings/storage", 4000],
    ["tap", "lock-pin-1"], ["tap", "lock-pin-4"], ["tap", "lock-pin-7"], ["tap", "lock-pin-2"],
    ["waitFor", "Where papers are kept", 10000],
    ["tap", "storage-both"],
    ["waitFor", "Keep a copy on this phone too?", 5000],
    ["slide", "slide-storage"],
    ["waitFor", "Kept on this phone and in the cloud", 30000],
    ["go", "/settings", 4000],
    ["tap", "lock-pin-1"], ["tap", "lock-pin-4"], ["tap", "lock-pin-7"], ["tap", "lock-pin-2"],
    ["waitFor", "Synced", 30000],
    ["expectNot", "waiting to sync"]
  ]
}
