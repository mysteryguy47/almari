# Copy to .env.local (git ignores it). For local development against `npx supabase start`,
# use the URL and publishable key that `npx supabase status` prints.
# For production, set the same two names in Vercel → Settings → Environment Variables
# with your Supabase project's values (Project Settings → API Keys). Both are public by design.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_...
